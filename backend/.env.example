# DB — 로컬 (docker compose up -d). 평가는 여기서만 돈다
DATABASE_URL=postgresql+psycopg://starchive:starchive@localhost:5433/starchive
DIRECT_URL=postgresql+psycopg://starchive:starchive@localhost:5433/starchive

# 배포 (Supabase).
# 포트로 모드가 갈린다. 6543 트랜잭션(앱), 5432 세션(마이그레이션)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:PW@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql+psycopg://postgres.<ref>:PW@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# 인증
JWT_SECRET=your_JWT_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false    # 배포는 true
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# 프론트
FRONTEND_ORIGIN=http://localhost:3000

# 외부 API
TMDB_API_KEY=your_key
ALADIN_TTB_KEY=your_key
OPENAI_API_KEY=your_key

# 배치
CRON_SECRET=
REC_COOLDOWN_MINUTES=60
LLM_TIMEOUT_SECONDS=30
CRON_USER_LIMIT=5
CRON_STALE_HOURS=20

# 수집
MAX_CONCURRENCY=4
REQUEST_DELAY_SEC=0.3