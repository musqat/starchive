# DB
DATABASE_URL=postgresql+psycopg://user:PW@ep-xxx-pooler.us-east-1.aws.neon.tech/starchive?sslmode=require
DIRECT_URL=postgresql+psycopg://user:PW@ep-xxx.us-east-1.aws.neon.tech/starchive?sslmode=require

# 인증
JWT_SECRET=your_JWT_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false    # 배포는 true
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# 프론트
FRONTEND_ORIGIN=http://localhost:3000

# 외부 API
TMDB_API_KEY=your_key
ALADIN_TTB_KEY=your_key
OPENAI_API_KEY=your_key

# 배치
CRON_SECRET=
REC_COOLDOWN_MINUTES=60
LLM_TIMEOUT_SECONDS=30
CRON_USER_LIMIT=5
CRON_STALE_HOURS=20

# 수집
MAX_CONCURRENCY=4
REQUEST_DELAY_SEC=0.3